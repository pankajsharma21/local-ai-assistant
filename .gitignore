# Build output
target/
*.class

# IDE
.idea/
*.iml
.vscode/
.codesight/

# OS
.DS_Store

# Local data / generated state — these are regenerated by ingestion, don't commit them
data/store/*.json
data/docs/*
!data/docs/.gitkeep
!data/docs/sample-notes.md
data/code/*
!data/code/.gitkeep

# Voice binaries/models — downloaded by scripts/setup_voice.sh, not part of the repo
# (anchored to repo root only — do NOT let this match src/**/tools/, which is real source code)
/tools/

# Logs
*.log

# Copy this file to `.env` (which is git-ignored) and fill in your own values.
# ./scripts/run.sh loads .env automatically before starting the app.
#
# Keys belong here, NOT in application.yml — application.yml is tracked by git, so anything you
# put there ends up permanently in your repository history.
#
# These names look odd but are exactly how Spring Boot's "relaxed binding" maps environment
# variables onto config properties: uppercase, dots/dashes removed.
#   ASSISTANT_WEBSEARCH_ENABLED       ->  assistant.web-search.enabled
#   ASSISTANT_WEBSEARCH_TAVILYAPIKEY  ->  assistant.web-search.tavily-api-key

# --- Live web search (optional) ---
# Free key (1000 searches/month, no credit card): https://app.tavily.com
# Without this, current-facts questions still work via the always-on Wikipedia tool.
ASSISTANT_WEBSEARCH_ENABLED=true
ASSISTANT_WEBSEARCH_TAVILYAPIKEY=tvly-your-key-here
